# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (in the repo root OR in backend/) and fill values.
# NEVER commit the real `.env` — it is already git-ignored.
#
# LOCAL (one-click launcher)  → leave everything as-is; backend runs on
#                                127.0.0.1:8000, frontend on localhost:3000.
# CLOUD (Render + Vercel)      → set the values marked [CLOUD] below.
# ─────────────────────────────────────────────────────────────────────────

# [CLOUD] Comma-separated list of frontend origins allowed to call the API.
# Locally this defaults to localhost origins; on Render set it to your
# Vercel site URL, e.g.:  https://ai-accountant.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# [CLOUD] Render injects PORT automatically; normally leave unset.
# PORT=10000

# [CLOUD] Bind address. Local launcher overrides to 127.0.0.1; Render sets 0.0.0.0.
# HOST=0.0.0.0

# [CLOUD] Frontend (Vercel): the backend URL the app talks to.
# vercel.json already sets VITE_BACKEND_URL = https://ai-accountant-backend.onrender.com
# at build time, so the deployed app NEVER falls back to localhost:8000.
# (locally, frontend/services/backendService.ts falls back to http://localhost:8000)

# Optional: Google OAuth token verification (the app uses deterministic
# fallback when no AI provider key is present, so this is OPTIONAL).
# GEMINI_API_KEY=
# GOOGLE_CLIENT_ID=
